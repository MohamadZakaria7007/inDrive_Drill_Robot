{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product as returned in GET /products list items",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "price", "is_location_offer", "is_rental",
               "co2_rating", "in_stock", "is_eco_friendly", "product_image", "category", "brand"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9A-Z]{26}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "is_location_offer": {"type": "boolean"},
    "is_rental": {"type": "boolean"},
    "co2_rating": {"enum": ["A", "B", "C", "D", "E"]},
    "in_stock": {"type": "boolean"},
    "is_eco_friendly": {"type": "boolean"},
    "product_image": {
      "type": "object",
      "required": ["id", "file_name", "title"],
      "properties": {
        "id": {"type": "string"},
        "file_name": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "slug": {"type": "string"}
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
    }
  }
}
