# Copy to .env (git-ignored). Override per run with: robot --variable NAME:value ...
UI_BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com
# Toolshop demo customer account (published by the site); CI reads these from secrets.
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
# chrome | edge | firefox
BROWSER=chrome
HEADLESS=true
SELENIUM_TIMEOUT=10s
API_TIMEOUT_SECONDS=15
